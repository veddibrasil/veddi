APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo
APP_PORT=80
VITE_PORT=5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# CIDR do load balancer em prod (ex: 10.0.0.0/8). REMOTE_ADDR = apenas upstream imediato
TRUSTED_PROXIES=REMOTE_ADDR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Discord — logs críticos (payments, orders, chat, webhook encaminham automaticamente)
DISCORD_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/SEU_ID/SEU_TOKEN
DISCORD_LOG_LEVEL=critical

# Horizon — acesso ao dashboard de filas (e-mails separados por vírgula)
HORIZON_ADMIN_EMAILS=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Produção: alterar para 'reverb'
BROADCAST_CONNECTION=log

# Produção: alterar para 's3'
FILESYSTEM_DISK=local
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Sail: use 'redis' como host (rede Docker). Fora do Sail: 127.0.0.1
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

# Sail: use 'mailpit' como host e porta 1025
# Produção: configurar SMTP real e MAIL_FROM_ADDRESS com domínio próprio
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@seudominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# S3-compatible storage (obrigatório em produção para logos e imagens de produto)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mapbox — mapa de entrega no painel admin
MAPBOX_TOKEN=

# ─── Asaas (gateway de pagamento e assinaturas) ──────────────────────────────
# Produção: ASAAS_SANDBOX=false e chave de produção em ASAAS_API_KEY
ASAAS_API_KEY=
ASAAS_SANDBOX=true
ASAAS_WEBHOOK_TOKEN=
ASAAS_VEDDI_WALLET_ID=
ASAAS_PRO_MONTHLY_VALUE=49.90

# ─── Stark Bank (PIX) ────────────────────────────────────────────────────────
# Produção: STARK_SANDBOX=false
STARK_PROJECT_ID=
STARK_PRIVATE_KEY=
STARK_SANDBOX=true
STARK_WEBHOOK_TOKEN=

# ─── Z-API (WhatsApp — notificações de pedido) ───────────────────────────────
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# ─── Reverb (WebSocket — chat de pedidos em tempo real) ──────────────────────
# php artisan reverb:install gera REVERB_APP_KEY, REVERB_APP_SECRET e REVERB_APP_ID
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
