APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo
APP_PORT=80
VITE_PORT=5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# CIDR do load balancer em prod (ex: 10.0.0.0/8). REMOTE_ADDR = apenas upstream imediato
TRUSTED_PROXIES=REMOTE_ADDR

# Nightwatch — observabilidade (token gerado no dashboard Laravel Cloud)
NIGHTWATCH_TOKEN=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Discord — logs críticos (payments, orders, chat, webhook encaminham automaticamente)
DISCORD_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/SEU_ID/SEU_TOKEN
DISCORD_LOG_LEVEL=critical

# Discord — fluxo completo de geração de PIX (Vindi): início, sucesso e falha
DISCORD_PIX_LOG_WEBHOOK_URL=
DISCORD_PIX_LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Produção: alterar para 'reverb'
BROADCAST_CONNECTION=log

# Produção: alterar para 's3'
FILESYSTEM_DISK=local
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Sail: use 'redis' como host (rede Docker). Fora do Sail: 127.0.0.1
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

# Sail: use 'mailpit' como host e porta 1025
# Produção: configurar SMTP real e MAIL_FROM_ADDRESS com domínio próprio
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@seudominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# S3-compatible storage (obrigatório em produção para logos e imagens de produto)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mapbox — mapa de entrega no painel admin
MAPBOX_TOKEN=

# WhatsApp de suporte — botão flutuante no painel admin (formato: DDI+DDD+numero, ex: 5511999998888)
SUPPORT_WHATSAPP_NUMBER=

# ─── WhatsApp Cloud API (Meta) — notificações de pedido por número próprio de cada restaurante ───
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
# ID da configuração do Embedded Signup (Meta App > WhatsApp > Configuração de Login do Facebook)
WHATSAPP_ES_CONFIG_ID=
# Token de verificação do webhook (GET /webhooks/whatsapp) — string aleatória definida por nós
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Número da plataforma (homologação e fallback). Não fica na tabela whatsapp_connections.
WHATSAPP_PLATFORM_WABA_ID=
WHATSAPP_PLATFORM_PHONE_NUMBER_ID=
WHATSAPP_PLATFORM_TOKEN=
# true = empresas sem conexão ativa enviam pelo número da plataforma
WHATSAPP_FALLBACK_TO_PLATFORM=false

# QZ Tray (impressão PDV) — alternativa em base64 aos arquivos em
# storage/app/private/qz/ pra ambientes sem shell (ex.: Laravel Cloud).
# Gerar com: openssl req -x509 -newkey rsa:2048 -keyout private-key.pem -out digital-certificate.txt -days 3650 -nodes
# depois: base64 < private-key.pem | tr -d '\n'  (idem pro certificado)
QZ_PRIVATE_KEY=
QZ_CERTIFICATE=

# ─── Asaas (gateway de pagamento e assinaturas) ──────────────────────────────
# Produção: ASAAS_SANDBOX=false e chave de produção em ASAAS_API_KEY
ASAAS_API_KEY=
ASAAS_SANDBOX=true
ASAAS_WEBHOOK_TOKEN=


# ─── Vindi Intermediador (Yapay) — pagamentos de pedidos ─────────────────────
VINDI_TOKEN_ACCOUNT=
VINDI_CONSUMER_KEY=
VINDI_CONSUMER_SECRET=
VINDI_AUTHORIZATION_CODE=
VINDI_RESELLER_TOKEN=

# ─── iFood — hub distribuído (uma aplicação parceira pra toda a plataforma) ──
IFOOD_PARTNER_CLIENT_ID=
IFOOD_PARTNER_CLIENT_SECRET=
IFOOD_API_BASE_URL=https://merchant-api.ifood.com.br
IFOOD_TIMEZONE=America/Sao_Paulo
# Mostra as ferramentas do roteiro de homologação na tela da integração (só no ambiente das gravações)
IFOOD_HOMOLOGATION_MODE=false

# ─── 99Food — hub único (um app parceiro pra toda a plataforma) ──
FOOD99_ENABLED=false
# Empresas que veem a tela e podem conectar (ids separados por vírgula); vazio = todas com o módulo de integrações
FOOD99_COMPANY_IDS=
FOOD99_APP_ID=
FOOD99_APP_SECRET=
FOOD99_API_BASE_URL=https://openapi.99food.com
FOOD99_TIMEZONE=America/Sao_Paulo
# 1 = app 99Food Loja e API confirmam pedidos; 2 = só a API
FOOD99_ORDER_CONFIRM_METHOD=2
FOOD99_TOKEN_REFRESH_MARGIN=300
# Mostra respostas cruas da API na tela da integração (só no ambiente de homologação)
FOOD99_HOMOLOGATION_MODE=false

# PIX: taxa percentual 0,85% por transação
VINDI_PIX_RATE=0.0085
# PIX: margem da plataforma sobre a transação
VINDI_PIX_PLATFORM_RATE=0.0014

# ─── Reverb (WebSocket — chat de pedidos em tempo real) ──────────────────────
# php artisan reverb:install gera REVERB_APP_KEY, REVERB_APP_SECRET e REVERB_APP_ID
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Fiscal (Nota Fiscal)
FOCUS_NFE_TOKEN=
FOCUS_NFE_BASE_URL_HOMOLOGACAO=https://homologacao.focusnfe.com.br
FOCUS_NFE_BASE_URL_PRODUCAO=https://api.focusnfe.com.br
FOCUS_NFE_WEBHOOK_TOKEN=
# FISCAL_ENVIRONMENT=homologacao  # opcional — sem isso, segue o APP_ENV automaticamente
FISCAL_CRT=1
FISCAL_NFCE_SERIE=1
FISCAL_ADDON_PRICE=149.00

# Chat: email | whatsapp | none. Email exige mailer real em produção (nunca log).
CHAT_CODE_CHANNEL=email
# WhatsApp: chave geral; Meta exige template AUTHENTICATION/COPY_CODE aprovado.
CHAT_WHATSAPP_AUTH_ENABLED=false
CHAT_WHATSAPP_META_ENABLED=true
CHAT_WHATSAPP_WUZAPI_FALLBACK_ENABLED=false
CHAT_WHATSAPP_AUTH_TEMPLATE=veddi_confirmar_telefone
CHAT_WHATSAPP_AUTH_LANGUAGE=pt_BR
# Máquina WuzAPI existente; usar sessão/token próprios da Veddi, apenas para códigos.
WUZAPI_BASE_URL=https://wa.locufybr.com
WUZAPI_SESSION_TOKEN=

# E-mail marketing do super admin (docs/email-marketing.md). Domínio próprio, nunca o do transacional.
# resend = API do Resend + webhook (padrão) | mail = mailer "marketing" (smtp/ses/postmark/log)
MARKETING_EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Só com MARKETING_EMAIL_PROVIDER=mail (ex.: testar local sem gastar Resend). Sem isso cai no log.
# MARKETING_MAIL_TRANSPORT=log
# MARKETING_MAIL_HOST=
# MARKETING_MAIL_PORT=587
# MARKETING_MAIL_USERNAME=
# MARKETING_MAIL_PASSWORD=
MARKETING_FROM_ADDRESS="novidades@news.seudominio.com.br"
MARKETING_FROM_NAME="${APP_NAME}"
MARKETING_REPLY_TO=
# Domínios com SPF/DKIM no provedor (separados por vírgula); o disparo só sai com remetente deles
MARKETING_VERIFIED_DOMAINS=news.seudominio.com.br
# true = só quem deu aceite; false = legítimo interesse (todos menos descadastrados). Validar com o jurídico.
MARKETING_REQUIRE_OPT_IN=true
MARKETING_RATE_PER_SECOND=10
# Aquecimento do domínio: envios por dia (0 = sem limite)
MARKETING_DAILY_LIMIT=300
MARKETING_LEGAL_NAME=
MARKETING_LEGAL_DOCUMENT=
MARKETING_LEGAL_ADDRESS=
