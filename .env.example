APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo
APP_PORT=80
VITE_PORT=5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# CIDR do load balancer em prod (ex: 10.0.0.0/8). REMOTE_ADDR = apenas upstream imediato
TRUSTED_PROXIES=REMOTE_ADDR

# Nightwatch — observabilidade (token gerado no dashboard Laravel Cloud)
NIGHTWATCH_TOKEN=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Discord — logs críticos (payments, orders, chat, webhook encaminham automaticamente)
DISCORD_LOG_WEBHOOK_URL=https://discord.com/api/webhooks/SEU_ID/SEU_TOKEN
DISCORD_LOG_LEVEL=critical

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Produção: alterar para 'reverb'
BROADCAST_CONNECTION=log

# Produção: alterar para 's3'
FILESYSTEM_DISK=local
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Sail: use 'redis' como host (rede Docker). Fora do Sail: 127.0.0.1
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

# Sail: use 'mailpit' como host e porta 1025
# Produção: configurar SMTP real e MAIL_FROM_ADDRESS com domínio próprio
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@seudominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# S3-compatible storage (obrigatório em produção para logos e imagens de produto)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mapbox — mapa de entrega no painel admin
MAPBOX_TOKEN=

# ─── Asaas (gateway de pagamento e assinaturas) ──────────────────────────────
# Produção: ASAAS_SANDBOX=false e chave de produção em ASAAS_API_KEY
ASAAS_API_KEY=
ASAAS_SANDBOX=true
ASAAS_ALLOW_TRANSFERS_IN_NON_PROD=false
ASAAS_WEBHOOK_TOKEN=
ASAAS_VEDDI_WALLET_ID=
ASAAS_PRO_MONTHLY_VALUE=49.90
ASAAS_RESERVE_RATIO=0.05


# ─── Vindi Intermediador (Yapay) — pagamentos de pedidos ─────────────────────
VINDI_TOKEN_ACCOUNT=
VINDI_CONSUMER_KEY=
VINDI_CONSUMER_SECRET=
VINDI_ACCESS_TOKEN=
VINDI_AUTHORIZATION_CODE=
VINDI_REFRESH_TOKEN=
VINDI_RESELLER_TOKEN=

# PIX: taxa percentual 0,85% por transação
VINDI_PIX_RATE=0.0085
# PIX: margem da plataforma sobre a transação
VINDI_PIX_PLATFORM_RATE=0.0014
# Boleto: taxa fixa R$2,79 por boleto pago
VINDI_BOLETO_FEE=2.79
# ─── Reverb (WebSocket — chat de pedidos em tempo real) ──────────────────────
# php artisan reverb:install gera REVERB_APP_KEY, REVERB_APP_SECRET e REVERB_APP_ID
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Fiscal (Nota Fiscal)
FOCUS_NFE_TOKEN=
FOCUS_NFE_BASE_URL_HOMOLOGACAO=https://homologacao.focusnfe.com.br
FOCUS_NFE_BASE_URL_PRODUCAO=https://api.focusnfe.com.br
FOCUS_NFE_WEBHOOK_TOKEN=
# FISCAL_ENVIRONMENT=homologacao  # opcional — sem isso, segue o APP_ENV automaticamente
FISCAL_CRT=1
FISCAL_NFCE_SERIE=1
FISCAL_CERT_PATH=
FISCAL_CERT_PASSWORD=
FISCAL_ADDON_PRICE=65.00
