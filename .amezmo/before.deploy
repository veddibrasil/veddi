#!/bin/bash
set -e

# Symlink storage/logs to persistent storage
rm -rf "${DEPLOYMENT_DIRECTORY}/storage/logs"
mkdir -p "${STORAGE_DIRECTORY}/logs"
ln -s "${STORAGE_DIRECTORY}/logs" "${DEPLOYMENT_DIRECTORY}/storage/logs"

# Symlink storage/app to persistent storage
rm -rf "${DEPLOYMENT_DIRECTORY}/storage/app"
mkdir -p "${STORAGE_DIRECTORY}/app/public"
ln -s "${STORAGE_DIRECTORY}/app" "${DEPLOYMENT_DIRECTORY}/storage/app"

# Symlink public/storage -> storage/app/public
rm -rf "${DEPLOYMENT_DIRECTORY}/public/storage"
ln -s "${STORAGE_DIRECTORY}/app/public" "${DEPLOYMENT_DIRECTORY}/public/storage"
